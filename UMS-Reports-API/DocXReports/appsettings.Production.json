{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    // On Linux the LibreOfficeWrapper already returns /usr/bin/soffice
    // for PlatformID.Unix — this entry makes it explicit and visible.
    "LibreOfficePath": "/usr/bin/soffice"
  }
}
